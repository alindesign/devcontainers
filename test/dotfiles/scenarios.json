{
  "with-git-identity": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
      "dotfiles": {
        "gitUserName": "Test User",
        "gitUserEmail": "test@example.com"
      }
    }
  },
  "no-nvim": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
      "dotfiles": {
        "installNvim": false
      }
    }
  },
  "no-gh": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
      "dotfiles": {
        "installGhCli": false
      }
    }
  },
  "no-atuin": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
      "dotfiles": {
        "installAtuin": false
      }
    }
  },
  "no-tmux-config": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
      "dotfiles": {
        "installTmuxConfig": false
      }
    }
  },
  "atuin-sync-address": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
      "dotfiles": {
        "atuinSyncAddress": "https://atuin.example.com"
      }
    }
  }
}
